# Which backend adapter to use: firebase | memory
VITE_BACKEND=firebase

# Admin email (UI only; the real check lives in firestore.rules)
VITE_ADMIN_EMAIL=yanpeizhi2008@gmail.com

# Firebase web app config (Firebase console > Project settings > Your apps > PartyGames)
VITE_FIREBASE_API_KEY=
# Use this app's Hosting domain (<site-id>.web.app), not <project-id>.firebaseapp.com; see README.
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Set to true to use the local Firebase emulators (npm run emulators)
VITE_USE_EMULATORS=false
